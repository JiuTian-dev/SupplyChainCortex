{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node -e \"const{exec}=require('child_process');exec('docker compose up -d searxng 2>&1',(err,stdout,stderr)=>{if(err)console.log('[predev] Docker not available — SearXNG skipped. Run Docker Desktop first.');else console.log('[predev] SearXNG:',stdout.trim()||'started')})\"",
    "dev": "next dev -p 3000",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint . --max-warnings 999",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:tariff-seed": "bun run prisma/tariff-seed.ts",
    "db:tariff-scrape": "bun run scripts/scrape-ustr-tariffs.ts",
    "db:scfi-scrape": "bun run scripts/scrape-scfi-freight.ts",
    "db:carbon-scrape": "bun run scripts/scrape-eu-carbon.ts",
    "db:cpsc-scrape": "bun run scripts/scrape-cpsc-recalls.ts",
    "db:amazon-scrape": "bun run scripts/scrape-amazon-competitors.ts",
    "db:verify": "bun run scripts/verify-migration.ts",
    "db:seed": "bun run prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
