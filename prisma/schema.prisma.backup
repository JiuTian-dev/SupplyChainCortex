// 小家电供应链 MCP 数据管道 - 数据库 Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== 产品 ====================
model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  category    String
  subCategory String
  unitCost    Float
  sellingPrice Float
  weight      Float
  origin      String   @default("CN")
  abcClass    String   @default("C")
  fsnClass    String   @default("N")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventory   Inventory?
  cost        CostRecord?
  shipments   ShipmentItem[]
  salesRecords SalesRecord[]

  @@index([category])
  @@index([subCategory])
  @@index([category, subCategory])
}

// ==================== 库存 ====================
model Inventory {
  id            String   @id @default(cuid())
  productId     String   @unique
  sku           String
  productName   String
  warehouse     String
  quantity      Int
  safetyStock   Int
  reorderPoint  Int
  inTransit     Int      @default(0)
  turnoverRate  Float    @default(0)
  turnoverDays  Int      @default(0)
  stockStatus   String   @default("healthy") // healthy, warning, critical, overstock
  lastSyncAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product       Product  @relation(fields: [productId], references: [id])

  @@index([sku])
  @@index([warehouse])
  @@index([stockStatus])
  @@index([warehouse, stockStatus])
}

// ==================== 销售记录 ====================
model SalesRecord {
  id          String   @id @default(cuid())
  productId   String
  sku         String
  productName String
  date        String   // YYYY-MM-DD
  quantity    Int
  revenue     Float
  platform    String   // Amazon, Shopify, Walmart, eBay
  createdAt   DateTime @default(now())

  product     Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([date])
  @@index([platform])
  @@index([sku])
  @@index([productId, date])
  @@index([platform, date])
}

// ==================== 物流货运 ====================
model ShipmentItem {
  id              String   @id @default(cuid())
  trackingNumber  String   @unique
  productId       String
  sku             String
  productName     String
  origin          String
  destination     String
  carrier         String
  status          String   @default("pending") // pending, in_transit, customs, delivered, delayed, exception
  eta             String?
  actualDelivery  String?
  delayDays       Int      @default(0)
  riskLevel       String   @default("low") // low, medium, high, critical
  events          Json     @default("[]") // JSON array of logistics events
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product         Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([status])
  @@index([riskLevel])
  @@index([sku])
  @@index([status, riskLevel])
}

// ==================== 成本记录 ====================
model CostRecord {
  id            String   @id @default(cuid())
  productId     String   @unique
  sku           String
  productName   String
  rawMaterial   Float
  labor         Float
  logistics     Float
  tariff        Float
  platformFee   Float
  exchangeRate  Float    @default(7.25)
  destination   String   @default("US")
  totalLanded   Float
  sellingPrice  Float
  grossMargin   Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product       Product  @relation(fields: [productId], references: [id])

  @@index([sku])
}

// ==================== 预警规则 ====================
model AlertRule {
  id          String   @id @default(cuid())
  ruleId      String   @unique
  name        String
  field       String
  operator    String   // <, >, <=, >=, ==
  threshold   Float
  unit        String
  enabled     Boolean  @default(true)
  severity    String   @default("warning") // warning, critical
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
}

// ==================== 供应链事件 ====================
model SupplyChainEvent {
  id          String   @id @default(cuid())
  type        String   // 补货订单, 货运更新, 库存预警, 成本变更, 销售里程碑
  title       String
  description String
  icon        String   @default("📦")
  color       String   @default("#f97316")
  severity    String   @default("info") // info, warning, critical
  sku         String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([sku])
  @@index([isRead])
  @@index([createdAt])
}

// ==================== 补货订单 ====================
model ReorderOrder {
  id          String   @id @default(cuid())
  sku         String
  productName String
  quantity    Int
  warehouse   String
  priority    String   @default("常规") // 常规, 紧急
  status      String   @default("pending") // pending, approved, shipped, delivered, cancelled
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sku])
  @@index([status])
  @@index([priority])
}

// ==================== 供应链备注 ====================
model SupplyChainNote {
  id          String   @id @default(cuid())
  sku         String
  author      String   @default("系统用户")
  content     String
  category    String   @default("general") // general, inventory, cost, logistics, sales
  priority    String   @default("normal")  // normal, important, urgent
  isResolved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sku])
  @@index([category])
  @@index([priority])
  @@index([isResolved])
  @@index([isResolved, priority])
}

// ==================== 供应商 ====================
model Supplier {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  contact       String?
  email         String?
  phone         String?
  region        String
  category      String   // 供应品类
  leadTime      Int      @default(14) // 平均交货天数
  rating        Float    @default(0) // 0-5 评分
  ratingDetails Json?    // JSON: { deliveryScore, qualityScore, priceScore, communicationScore, comments, ratedAt }
  status        String   @default("active") // active, suspended, inactive
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([region])
  @@index([category])
  @@index([status])
}

// ==================== 审计日志 ====================
model AuditLog {
  id          String   @id @default(cuid())
  action      String   // CREATE, UPDATE, DELETE, IMPORT, EXPORT, ADJUST, TRANSFER, RATE, SIMULATE
  entity      String   // product, inventory, shipment, note, supplier, reorder, alert_rule, cost
  entityId    String?  // ID of the affected entity
  sku         String?  // Related SKU if applicable
  userId      String   @default("system") // Who performed the action
  userName    String   @default("系统用户")
  details     Json     // JSON object with action details
  ipAddress   String?  // Request IP (when available)
  userAgent   String?  // Request user agent
  severity    String   @default("info") // info, warning, important
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([entity])
  @@index([sku])
  @@index([userId])
  @@index([createdAt])
  @@index([entity, action])
  @@index([severity, createdAt])
}

// ==================== 用户与权限 ====================
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  password      String   // bcrypt hashed
  role          String   @default("viewer") // admin, manager, viewer
  avatar        String?
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// ==================== 质量管理 ====================

// 退货记录
model ReturnRecord {
  id            String   @id @default(cuid())
  sku           String
  productName   String
  quantity      Int
  reason        String   // 质量/物流/规格/其他
  reasonDetail  String?  // 详细原因
  platform      String?  // Amazon/Shopify/eBay/Walmart/Temu
  costImpact    Float    @default(0) // 退货成本影响
  status        String   @default("pending") // pending/processed/refunded/rejected
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sku])
  @@index([reason])
  @@index([platform])
  @@index([status])
  @@index([createdAt])
}

// 缺陷记录
model DefectRecord {
  id            String   @id @default(cuid())
  sku           String
  productName   String
  defectType    String   // 外观/功能/包装/安全
  severity      String   @default("minor") // minor/major/critical
  quantity      Int      @default(1)
  detectedAt    String   // 检测环节: incoming/in-process/outgoing/customer
  rootCause     String?
  correctiveAction String? // 纠正措施
  status        String   @default("open") // open/investigating/resolved/closed
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sku])
  @@index([defectType])
  @@index([severity])
  @@index([status])
  @@index([detectedAt])
}

// 质保成本记录
model WarrantyCost {
  id            String   @id @default(cuid())
  sku           String
  productName   String
  category      String   // repair/replacement/refund/support
  cost          Float
  description   String?
  claimDate     String   // YYYY-MM-DD
  resolvedDate  String?
  status        String   @default("submitted") // submitted/approved/rejected/completed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sku])
  @@index([category])
  @@index([status])
  @@index([claimDate])
}

// ==================== 合规认证 ====================

// 合规证书
model ComplianceCert {
  id            String   @id @default(cuid())
  certName      String   // 证书名称: CE/FCC/CCC/RoHS/UL/ETL 等
  certNumber    String?  // 证书编号
  issuer        String?  // 发证机构
  sku           String?  // 关联SKU (null=公司级)
  productName   String?  // 关联产品名
  category      String   // safety/emc/environmental/quality/other
  issueDate     String?  // 发证日期
  expiryDate    String   // 到期日期
  status        String   @default("active") // active/expiring/expired/revoked/pending
  scope         String?  // 认证范围
  documentUrl   String?  // 证书文件URL
  notes         String?  // 备注
  reminderDays  Int      @default(90) // 提前多少天提醒
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([certName])
  @@index([sku])
  @@index([status])
  @@index([expiryDate])
  @@index([category])
}

// 法规变更
model RegulationChange {
  id            String   @id @default(cuid())
  title         String
  source        String   // EU/FDA/GB/SAA/other
  category      String   // safety/emc/environmental/labeling/other
  description   String
  impactLevel   String   @default("medium") // low/medium/high/critical
  effectiveDate String?  // 生效日期
  deadline      String?  // 合规截止日期
  affectedSkus  String   @default("[]") // JSON array of affected SKUs
  affectedCerts String   @default("[]") // JSON array of affected cert IDs
  actionRequired String? // 需要采取的行动
  status        String   @default("new") // new/reviewing/action_required/compliant/non_compliant
  sourceUrl     String?  // 来源URL
  reviewedBy    String?  // 审核人
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([source])
  @@index([category])
  @@index([impactLevel])
  @@index([status])
  @@index([effectiveDate])
}
