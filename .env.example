# SupplyChain Cortex — Environment Variables
# Copy this file to .env and fill in your values

# Database (SQLite default, can switch to MySQL/Postgres)
DATABASE_URL="file:./db/custom.db"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-string

# AI Providers (optional — set at least one)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Commodity Prices — FRED (St. Louis Fed), free API key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Frankfurter API (free, no key needed for exchange rates)
# FRANKFURTER_BASE_URL=https://api.frankfurter.app
