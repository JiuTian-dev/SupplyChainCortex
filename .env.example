# SupplyChain Cortex — Environment Variables
# Copy this file to .env and fill in your values

# Database — PostgreSQL (via docker compose or local install)
#   docker compose up -d postgres    → starts PostgreSQL 16
DATABASE_URL="postgresql://supplychain:supplychain@localhost:5432/supply_chain"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-string

# AI Providers (optional — set at least one)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Commodity Prices — FRED (St. Louis Fed), free API key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Commodity Prices — Alpha Vantage daily data, free key at https://www.alphavantage.co/support/#api-key
# Covers copper + aluminum daily; 25 free requests/day
ALPHA_VANTAGE_API_KEY=

# PBOC Exchange Rate Midpoint — ALAPI, free token at https://www.alapi.cn
# Provides daily PBOC/SAFE central parity (中间价) for 25 currencies
ALAPI_TOKEN=

# Cache Backend — choose one
#   memory   (default): Process-local Map, fastest, lost on restart
#   postgres:           PostgreSQL UNLOGGED table, survives restarts, shared across instances
#   redis   (planned):  Redis/Valkey for multi-instance deployments
# CACHE_BACKEND=memory

# Web Search Provider — choose one
#   searxng: Self-hosted, unlimited, zero cost (docker compose up -d)
#   brave:   Free 2000 searches/month, key at https://brave.com/search/api/
#   tavily:  Free 1000 searches/month, key at https://tavily.com
#   jina:    Free tier, no API key needed
SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=http://localhost:8081
# BRAVE_API_KEY=
# TAVILY_API_KEY=

# Prisma connection pool size. 5 is safe for serverless; increase for dedicated servers.
# PRISMA_CONNECTION_LIMIT=5

# PostgreSQL external access (docker-compose). Bind to localhost by default.
# Set to "0.0.0.0:5432" only if you need remote DB access.
# POSTGRES_EXTERNAL_PORT=127.0.0.1:5432

# Database backup (see scripts/backup-db.sh)
# DB_HOST=localhost  DB_PORT=5432  DB_USER=supplychain  DB_NAME=supply_chain
