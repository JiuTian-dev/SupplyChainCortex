# SupplyChain Cortex — Environment Variables
# Copy this file to .env and fill in your values

# Database — PostgreSQL (via docker compose or local install)
#   docker compose up -d postgres    → starts PostgreSQL 16
DATABASE_URL="postgresql://supplychain:supplychain@localhost:5432/supply_chain"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-string

# AI Providers (optional — set at least one)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Commodity Prices — FRED (St. Louis Fed), free API key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Commodity Prices — Alpha Vantage daily data, free key at https://www.alphavantage.co/support/#api-key
# Covers copper + aluminum daily; 25 free requests/day
ALPHA_VANTAGE_API_KEY=

# PBOC Exchange Rate Midpoint — ALAPI, free token at https://www.alapi.cn
# Provides daily PBOC/SAFE central parity (中间价) for 25 currencies
ALAPI_TOKEN=

# Cache Backend — choose one
#   memory   (default): Process-local Map, fastest, lost on restart
#   postgres:           PostgreSQL UNLOGGED table, survives restarts, shared across instances
#   redis   (planned):  Redis/Valkey for multi-instance deployments
# CACHE_BACKEND=memory

# ─── Billing / SaaS (scaffold — disabled by default) ───────────────────────────
# Set BILLING_ENABLED=true to activate Stripe subscription billing.
# When disabled, all quota checks pass and billing routes return 503.
# stripe package is in optionalDependencies; run `npm install --no-optional` to skip.
BILLING_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_FREE=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_ENTERPRISE=
# STRIPE_WEBHOOK_SECRET=

# Web Search Provider — choose one
#   searxng: Self-hosted, unlimited, zero cost (docker compose up -d)
#   brave:   Free 2000 searches/month, key at https://brave.com/search/api/
#   tavily:  Free 1000 searches/month, key at https://tavily.com
#   jina:    Free tier, no API key needed
SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=http://localhost:8081
# BRAVE_API_KEY=
# TAVILY_API_KEY=

# Prisma connection pool size. 5 is safe for serverless; increase for dedicated servers.
# PRISMA_CONNECTION_LIMIT=5

# PostgreSQL external access (docker-compose). Bind to localhost by default.
# Set to "0.0.0.0:5432" only if you need remote DB access.
# POSTGRES_EXTERNAL_PORT=127.0.0.1:5432

# Database backup (see scripts/backup-db.sh)
# DB_HOST=localhost  DB_PORT=5432  DB_USER=supplychain  DB_NAME=supply_chain

# ─────────────────────────────────────────────────────────────────────
# Multi-Tenant SaaS Configuration (v1.0 — 2026-06-18)
# 详见：vibe路径/SupplyChain-Cortex-SaaS-部署架构.md
# ─────────────────────────────────────────────────────────────────────

# ─── Tenant Resolution ───────────────────────────────────────────────
# 租户识别模式：subdomain | header | path（推荐 subdomain）
TENANT_MODE=subdomain
# 主域名（子域名模式：{tenant}.BASE_DOMAIN）
BASE_DOMAIN=cortex.app
# 默认租户 ID（未识别租户时回退，仅开发环境使用）
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# ─── Database (SaaS / Production) ────────────────────────────────────
# 生产环境经 PgBouncer 连接池（事务级池化，兼容 Prisma）
# DATABASE_URL="postgresql://supplychain:password@pgbouncer.internal:6432/supply_chain?connection_limit=3&pgbouncer=true&connection_timeout=30"
# 只读副本（读写分离，可选）
DATABASE_READ_URL=
# PgBouncer 连接池大小（Serverless 建议 2-3，长驻服务 10-15）
# PRISMA_CONNECTION_LIMIT=3

# ─── Redis / Cache ───────────────────────────────────────────────────
# 缓存后端：memory | postgres | redis（SaaS 推荐 redis）
CACHE_BACKEND=redis
# Redis 连接（缓存实例，allkeys-lru）
REDIS_URL=redis://localhost:6379/0
# Redis 会话实例（noeviction，建议与缓存分离）
REDIS_SESSION_URL=redis://localhost:6379/1
# Redis 限流实例
REDIS_RATELIMIT_URL=redis://localhost:6379/2

# ─── NextAuth (SaaS 升级) ────────────────────────────────────────────
# 会话超时（秒），默认 24 小时
# NEXTAUTH_SESSION_MAX_AGE=86400
# 静默续期间隔（秒），默认 1 小时
# NEXTAUTH_SESSION_UPDATE_AGE=3600

# ─── OAuth Providers ─────────────────────────────────────────────────
# Google OAuth（Google Cloud Console → OAuth 2.0 Client ID）
# 回调 URL：https://cortex.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth（GitHub Developer Settings → OAuth Apps）
# 回调 URL：https://cortex.app/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Python Bridge Service ───────────────────────────────────────────
# FastAPI 常驻服务地址（供应链数学引擎，端口 8765）
PYTHON_BRIDGE_URL=http://localhost:8765
PYTHON_BRIDGE_PORT=8765
# Python 服务工作进程数（生产建议 2-4）
# PYTHON_BRIDGE_WORKERS=2

# ─── Object Storage (备份 / 导出 / 静态资源) ─────────────────────────
# S3 兼容存储（AWS S3 / Cloudflare R2 / 阿里云 OSS）
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=  # R2/OSS 自定义端点，AWS S3 留空
# 备份保留天数
BACKUP_RETENTION_DAYS=30

# ─── Monitoring & Observability ──────────────────────────────────────
# Sentry（错误监控）
SENTRY_DSN=
# OpenTelemetry（分布式追踪）
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TOKEN=
# 日志级别：debug | info | warn | error
LOG_LEVEL=info
# 应用版本（CI 注入）
APP_VERSION=1.0.0

# ─── Rate Limiting ───────────────────────────────────────────────────
# 全局限流（每 IP 每分钟）
RATE_LIMIT_GLOBAL=1000
# 租户限流（每租户每分钟）
RATE_LIMIT_TENANT=500
# 用户限流（每用户每分钟）
RATE_LIMIT_USER=100
# API Key 限流（每 Key 每分钟）
RATE_LIMIT_API=60
# 登录尝试限制（每邮箱+IP 15分钟内）
RATE_LIMIT_LOGIN=5

# ─── Encryption ──────────────────────────────────────────────────────
# 敏感字段加密密钥（32 字节 hex，64 字符）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ─── LLM Cost Control ────────────────────────────────────────────────
# LLM 路由策略：simple（低成本）| balanced（平衡）| quality（高质量）
LLM_ROUTER_STRATEGY=balanced
# 默认模型（简单查询）
LLM_DEFAULT_MODEL=deepseek-chat
# 复杂推理模型
LLM_REASONING_MODEL=deepseek-reasoner
# 高质量模型（备用）
LLM_PREMIUM_MODEL=gpt-4o

# ─── Deployment ──────────────────────────────────────────────────────
# 部署环境：development | staging | production
DEPLOY_ENV=development
# CDN 域名（生产静态资源）
CDN_DOMAIN=
# 时区（影响定时任务）
TZ=Asia/Shanghai

# ─── Compliance (中国数据出境) ───────────────────────────────────────
# 数据驻留区域：cn | global | hybrid
DATA_RESIDENCY=global
# 是否启用 PII 脱敏（调用境外 LLM 前移除个人信息）
PII_REDACTION_ENABLED=true
